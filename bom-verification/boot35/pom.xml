<?xml version="1.0" encoding="UTF-8"?>
<!--
    Scenario: Spring Boot 3.5.x / Framework 6.2 consumer.

    Uses the framework-free members only: agent-client-* is excluded because its
    compile-scope spring-ai 2.x dependency requires Framework 7 (Boot 4 line).
    Boot 3.5 consumers use journal/capture/sdk (and other Spring-free members)
    directly; Boot's jackson-bom manages Jackson 2 for the whole app.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.markpollack</groupId>
        <artifactId>agentworks-bom-verification</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>bom-verify-boot35</artifactId>

    <dependencyManagement>
        <dependencies>
            <!-- A real consumer's order: their Boot BOM alongside agentworks-bom
                 (agentworks-bom is imported by the parent; Boot's import here is
                 what manages Jackson 2 for a Boot 3.5 app). -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot-35.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>journal-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>claude-code-capture</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>claude-code-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- requireUpperBoundDeps is intentionally skipped here: Spring Boot's
                 dependencyManagement deliberately curates transitives downward
                 (e.g. reactor, snakeyaml) and is authoritative in a Boot app.
                 The runtime JacksonConvergenceTest is the gate in this scenario. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jackson-convergence-gate</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
