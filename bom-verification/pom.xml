<?xml version="1.0" encoding="UTF-8"?>
<!--
    agentworks BOM verification — the golden-path quality gate.

    Consumes agentworks-bom exactly like a fresh consumer and verifies, per scenario:
      1. maven-enforcer requireUpperBoundDeps  — no dependency resolves below what
         another dependency requires (this is what a mixed Jackson set looks like).
      2. JacksonConvergenceTest                — all Jackson 2 jars report one version,
         the SDK message-parse path works, and TraceWriter output is non-empty
         (the agentworks-bom 1.5.0 runtime regression).

    Scenarios:
      plain   — no Spring at all (the teardown consumer)
      boot35  — Spring Boot 3.5.x / Framework 6.2 consumer (Jackson 2 native)
      boot4   — Spring Boot 4.0.x / Framework 7 consumer (Jackson 3 default, Jackson 2 side-by-side)

    Run:  ../mvnw -f bom-verification/pom.xml verify
    Gate an older BOM:  ../mvnw -f bom-verification/pom.xml verify -Dagentworks-bom.version=1.5.0

    NOT published — verification only.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.markpollack</groupId>
    <artifactId>agentworks-bom-verification</artifactId>
    <version>1.7.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AgentWorks BOM Verification</name>

    <modules>
        <module>plain</module>
        <module>boot35</module>
        <module>boot4</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.deploy.skip>true</maven.deploy.skip>

        <agentworks-bom.version>1.7.0-SNAPSHOT</agentworks-bom.version>
        <spring-boot-35.version>3.5.14</spring-boot-35.version>
        <spring-boot-4.version>4.0.6</spring-boot-4.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agentworks-bom</artifactId>
                <version>${agentworks-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Test deps for every scenario (versions from the BOM's junit/assertj management) -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- One shared test source for all scenarios -->
        <testSourceDirectory>${project.basedir}/../src-shared/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>jackson-convergence-gate</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireUpperBoundDeps/>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
