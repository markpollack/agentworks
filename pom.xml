        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- Jackson 2 — patched default for framework-free consumers. Boot consumers may select
             their maintenance line's Jackson patch when their Boot BOM has consumer precedence.
             This import also protects consumers from third-party transitive strays. -->
        <jackson.version>2.22.2</jackson.version>
        <!-- Jackson 3 requires the separately versioned Jackson 2 annotations artifact. -->
        <jackson-annotations.version>2.22</jackson-annotations.version>

        <!-- Jackson 3 (tools.jackson) — converge Spring AI 2.0's transitive Jackson 3 to a
             CVE-clear floor; jsonschema-generator pulls an older jackson-core transitively. -->
        <jackson3.version>3.2.2</jackson3.version>
        <!-- NetworkNT JSON Schema Validator — direct floor for no-parent consumers. -->
        <networknt-json-schema-validator.version>3.0.7</networknt-json-schema-validator.version>
        <!-- JSpecify — converge the 1.0.0/1.0.1 split in the combined public consumer graph. -->
        <jspecify.version>1.0.1</jspecify.version>
        <!-- Reactor — converge maintained consumers on the current authorized 3.8.x line. -->
        <reactor.version>3.8.7</reactor.version>

        <!-- Spring AI — keep every managed Spring AI artifact on the GA line for consumers. -->
        <spring-ai.version>2.0.1</spring-ai.version>

        <!-- Test infrastructure versions -->
        <mockito.version>5.23.0</mockito.version>
        <byte-buddy.version>1.18.12</byte-buddy.version>
        <assertj.version>3.27.7</assertj.version>
        <junit-jupiter.version>5.14.4</junit-jupiter.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jackson BOM — single converged Jackson 2 version for consumers -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Jackson annotations are shared with Jackson 3 and version independently. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson-annotations.version}</version>
            </dependency>

            <!-- Jackson 3 BOM (tools.jackson) — converge Spring AI 2.0's transitive Jackson 3 so
                 jackson-core resolves to the patched floor for non-Boot consumers. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- NetworkNT — retain the security floor when consumers import this BOM. -->
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${networknt-json-schema-validator.version}</version>
            </dependency>

            <!-- JSpecify — select the current compatible 1.x annotation contract. -->
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

            <!-- Reactor — converge maintained consumers on the current authorized 3.8.x line. -->
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-core</artifactId>
                <version>${reactor.version}</version>
            </dependency>

            <!-- Spring AI BOM — converge ALL spring-ai artifacts to GA for consumers. Clears
                 CVE-2026-41712 (spring-ai-client-chat 2.0.0-M3 via workflow-flows). Imported AFTER
                 the jackson/reactor pins above so those win for shared transitives. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
