    <dependencyManagement>
        <dependencies>
            <!-- Jackson is deliberately NOT managed here, and this absence is load-bearing.
                 This BOM is framework-neutral: a consumer's framework owns its own Jackson line.
                 Managing it here silently overrode Spring Boot's Jackson, overrode Quarkus's
                 depending on import order, and injected a Jackson 2 databind into Micronaut
                 consumers alongside Micronaut's own differently-versioned annotations.
                 Consumers now get their framework's Jackson; framework-free consumers get
                 whatever the member libraries converge on, which is verified by
                 bom-verification's plain scenario. The CVE-clean minimum is enforced by the
                 per-project consumer gates, not pinned from here. Do not re-add these entries
                 without re-measuring a Boot, Quarkus and Micronaut consumer. -->

            <!-- NetworkNT — retain the security floor when consumers import this BOM. -->
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${networknt-json-schema-validator.version}</version>
            </dependency>

